# Credentials. These two files hold live DB and SMTP passwords, so the real
# ones are never tracked — copy the .example templates and fill them in on
# each machine/server instead.
/admin/config/db.php
/admin/config/mail_config.php

# Client-uploaded media (managed through the admin, restored from backup)
/uploads/*
!/uploads/.gitkeep
!/uploads/gallery/.gitkeep
!/uploads/pages/.gitkeep

# Source material — large, unoptimised, not deployed
/client_assets/

# Reference theme — kept locally for lookup, not part of the build
/reference/

# OS / editor noise
Thumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/
*.swp

# Logs and dumps
*.log
/database/*.backup.sql

# Local backup/export archives — full project/asset zips, not part of the
# build and too large for git (site3*.zip exceed GitHub's 100MB limit)
/site3.zip
/site3_v2.zip
/site3_v3.zip
/site3_v4_subpages.zip
/assets/img.zip

# Playwright MCP scratch output (screenshots taken during verification)
/.playwright-mcp/
